{
  "manifest_version": 3,
  "name": "TPVal Sync",
  "version": "0.1.0",
  "description": "Sincroniza tus cookies de Riot con val.migueltaibo.com para acceder a tienda, inventario y loadout.",
  "permissions": ["cookies", "alarms", "storage", "notifications"],
  "host_permissions": [
    "*://*.riotgames.com/*",
    "https://val.migueltaibo.com/*",
    "http://val.migueltaibo.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TPVal Sync"
  }
}
