#!/bin/sh
# TPCloud's server: curl -fsSL https://tpcloud.migueltaibo.com/install | sh
# The same installer as /get, going straight to «As your cloud»: it picks the file for this machine
# (arm64 for a Raspberry Pi, amd64 for a PC), downloads it and runs `tpcloud install`, which asks
# the rest in the terminal.
set -eu
script="$(mktemp)"
trap 'rm -f "$script"' EXIT
if command -v curl >/dev/null 2>&1; then
  curl -fsSL https://tpcloud.migueltaibo.com/get -o "$script"
else
  wget -q -O "$script" https://tpcloud.migueltaibo.com/get
fi
sh "$script" --server
