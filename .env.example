# Written by install.sh; edit and run `docker compose up -d` to apply.

# -------  Address  -------

TPCLOUD_URL=https://cloud.example.com   # where everything is served from; each module is a path under it
TPCLOUD_SITE=:80                         # what Caddy listens as: ":80" behind a tunnel or `tailscale serve`,
                                         # "cloud.example.com" to get its own certificate, "https://<name>.local" for LAN only
TPCLOUD_TLS=none                         # "internal" for LAN only (certificate from Caddy's own authority)
TPCLOUD_MODULES=store,home               # modules the dashboard and apps show

# What reaches beyond this machine (host:port). Defaults stay on localhost.
#TPCLOUD_HTTP_PUBLISH=127.0.0.1:8080
#TPCLOUD_HTTPS_PUBLISH=443
#TPCLOUD_OTA_PUBLISH=80                  # tphome's OTA firmware, LAN only

# -------  What runs  -------

COMPOSE_PROFILES=store                   # add ",tunnel" for your own domain through Cloudflare
#TUNNEL_TOKEN=

# -------  Auth  -------

DATABASE_URL=sqlite:///data/tpauth.db
RP_NAME=TPCloud
#RP_ID=example.com                       # only to keep passkeys made for a parent domain
#TPCLOUD_GEOIP=1                         # look up where sessions sign in from (sends their IP to ip-api.com)
#TPADMIN_UPSTREAM=172.20.0.1:8100        # tpadmin, if it runs on the host

# -------  Store  -------

EXTERNAL_DISK_PATH=/mnt/external         # host folder for users' files and photos
AUTH_SERVICE_URL=http://auth:8000
#TPSTORE_BACKUP_MOUNT=/mnt               # host disks for the admin backup (rsync /mnt/storage → /mnt/backup)
