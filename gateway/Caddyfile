{
    auto_https off
    admin off
}

(protected) {
    forward_auth auth:8000 {
        uri /auth/passkey/validate
        copy_headers Set-Cookie
    }
}

http://login.migueltaibo.com {
    handle /auth/* {
        reverse_proxy auth:8000
    }
    handle {
        reverse_proxy login:80
    }
}

http://cloud.migueltaibo.com {
    handle /auth/* {
        reverse_proxy auth:8000
    }
    handle {
        import protected
        reverse_proxy cloud:80
    }
}

http://accounts.migueltaibo.com {
    handle /auth/* {
        reverse_proxy auth:8000
    }
    handle {
        import protected
        reverse_proxy accounts:80
    }
}

http://store.migueltaibo.com {
    @filethumb path_regexp ^/api/files/thumbnail$
    @sharethumb path_regexp ^/api/share/[^/]+/files/thumbnail$

    handle /auth/* {
        reverse_proxy auth:8000
    }
    handle @filethumb {
        import protected
        reverse_proxy store-api:8000
    }
    handle @sharethumb {
        import protected
        reverse_proxy store-api:8000
    }
    handle /api/* {
        import protected
        header Cache-Control "no-store, no-cache, must-revalidate"
        reverse_proxy store-api:8000
    }
    handle {
        import protected
        header Cache-Control "no-store, no-cache, must-revalidate"
        reverse_proxy store-frontend:80
    }
}

http://share.migueltaibo.com {
    @sharethumb path_regexp ^/api/share/[^/]+/files/thumbnail$

    handle @sharethumb {
        reverse_proxy store-api:8000
    }
    handle /api/share* {
        header Cache-Control "no-store, no-cache, must-revalidate"
        reverse_proxy store-api:8000
    }
    handle /api/open/* {
        header Cache-Control "no-store, no-cache, must-revalidate"
        reverse_proxy store-api:8000
    }
    handle {
        header Cache-Control "no-store, no-cache, must-revalidate"
        reverse_proxy share-frontend:80
    }
}

http://tphome.migueltaibo.com {
    header Cache-Control "no-store, no-cache, must-revalidate"

    handle /auth/* {
        reverse_proxy auth:8000
    }
    handle /api/ws {
        reverse_proxy tphome-api:8000
    }
    handle /api/* {
        import protected
        reverse_proxy tphome-api:8000
    }
    handle /openapi.json {
        import protected
        reverse_proxy tphome-api:8000
    }
    handle /firmware {
        import protected
        reverse_proxy tphome-api:8000
    }
    handle {
        import protected
        reverse_proxy tphome-frontend:80
    }
}

http://game.migueltaibo.com {
    root * /srv/game
    file_server
    encode gzip
}

http://admin.migueltaibo.com {
    header Cache-Control "no-store, no-cache, must-revalidate"

    handle /auth/* {
        reverse_proxy auth:8000
    }
    # tpadmin runs on the host (it drives docker, git and tmux), listening only on this
    # network's bridge IP; it also requires is_admin on every endpoint itself.
    handle {
        import protected
        reverse_proxy 172.20.0.1:8100
    }
}
