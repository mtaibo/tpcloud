# Every module is served from one host, each under its own path:
#
#   /login  /accounts  /           tpcloud (sign-in, account, dashboard)
#   /store  /share  /photos        tpstore (files, public share links, gallery)
#   /home                          tphome
#   /auth                          the auth API every client signs in against
#
# Each module's API lives under its own path too (/store/api, /home/api…). The prefix is stripped
# here, so the services behind it still see the /api/... paths they always had.
{
	admin off
	servers {
		# Requests arrive through cloudflared, `tailscale serve` or Docker's own proxy, all from
		# private addresses. Only from those is the client's real IP taken from these headers.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(protected) {
	forward_auth auth:8000 {
		uri /auth/passkey/validate
		copy_headers Set-Cookie
		# The check itself is a plain GET: passing on a WebSocket's Upgrade made auth refuse it
		# (403) and the gateway drop every socket, e.g. tphome's live states.
		header_up -Upgrade
		header_up -Connection
	}
}

# Deferred (the `-Server` delete makes Caddy apply these as the response goes out), so the CSP
# and frame policy are only defaults: tpstore sends its own sandbox CSP for users' files, and
# overwriting it would let an uploaded HTML file run scripts on this origin.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		?X-Frame-Options SAMEORIGIN
		Referrer-Policy same-origin
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' wss://{hostport}; frame-src 'self' blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

# Vite puts a content hash in every asset's name, so they can be cached for good; everything else
# defaults to not being cached at all.
(caching) {
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-store"
}

(tls_none) {
}

# Only for the "this network only" setup: a certificate from Caddy's own local authority.
(tls_internal) {
	tls internal
}

{$TPCLOUD_SITE} {
	import tls_{$TPCLOUD_TLS}
	import security_headers
	encode zstd gzip

	handle /auth/* {
		header Cache-Control "no-store"
		reverse_proxy auth:8000 {
			header_up X-Real-IP {client_ip}
		}
	}

	# /login and /accounts answer at their plain address too, so nothing redirects to a trailing
	# slash (the pages tidy their own URL).
	@login path /login /login/*
	handle @login {
		route {
			rewrite /login /login/?{query}
			uri strip_prefix /login
			import caching
			reverse_proxy login:80
		}
	}

	@accounts path /accounts /accounts/*
	handle @accounts {
		route {
			import protected
			rewrite /accounts /accounts/?{query}
			uri strip_prefix /accounts
			import caching
			reverse_proxy accounts:80
		}
	}

	redir /store /store/ 308
	handle /store/* {
		route {
			# Thumbnails, posters and previews skip the gateway's session check: store-api checks
			# the session itself on every one of them (against auth, cached and shared across a
			# burst), and a gallery asks for hundreds at once, each paying for both checks.
			@store_media path /store/api/files/thumbnail /store/api/files/poster /store/api/files/preview
			handle @store_media {
				uri strip_prefix /store
				reverse_proxy store-api:8000
			}
			import protected
			uri strip_prefix /store
			# Thumbnails set their own long caching; other API answers are never cached.
			header /api/* ?Cache-Control "no-store"
			reverse_proxy /api/* store-api:8000
			import caching
			reverse_proxy store-frontend:80
		}
	}

	# tpstore's gallery, a section of its own. Only the page is served here: its data comes from
	# tpstore's API under /store/api, like the store's.
	redir /photos /photos/ 308
	handle /photos/* {
		route {
			import protected
			uri strip_prefix /photos
			import caching
			reverse_proxy photos-frontend:80
		}
	}

	# Public share links. Only the share endpoints of tpstore's API are reachable from here,
	# never the rest of it.
	redir /share /share/ 308
	handle /share/* {
		route {
			uri strip_prefix /share
			@share_api path /api/share /api/share/* /api/open/*
			# Only a default: thumbnails, posters and previews set their own long caching (their URLs
			# carry the file's version), and forcing no-store on them made every visit download each
			# photo and video again.
			header @share_api ?Cache-Control "no-store"
			reverse_proxy @share_api store-api:8000
			respond /api/* 404
			import caching
			reverse_proxy share-frontend:80
		}
	}

	redir /home /home/ 308
	handle /home/* {
		route {
			import protected
			uri strip_prefix /home
			@home_api path /api/* /openapi.json /firmware
			header @home_api Cache-Control "no-store"
			reverse_proxy @home_api tphome-api:8000
			import caching
			reverse_proxy tphome-frontend:80
		}
	}

	handle {
		route {
			import protected
			import caching
			reverse_proxy cloud:80
		}
	}
}

# OTA downloads for tphome's switches. They fetch http://<server LAN IP>/firmware with no session,
# so this listener sits on its own port (published on the LAN only, never through the tunnel) and
# serves that one path only.
:8081 {
	handle /firmware {
		reverse_proxy tphome-api:8000
	}
	handle {
		respond 404
	}
}

# Site blocks for this one server only (gitignored), e.g. old addresses that now redirect here.
import extra/*.caddy
